{
  "name": "proton-mail-bridge-client",
  "version": "1.18.11",
  "description": "Proton Mail Bridge Client — full-featured CLI and Claude Desktop MCP for Proton Mail via Proton Bridge. Read, search, send, draft, archive, manage folders, and more.",
  "mcpName": "io.github.googlarz/proton-mail-bridge-client",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./services": "./dist/lib.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "proton-mail-bridge-client": "dist/cli.js",
    "proton-mail-bridge": "dist/cli.js",
    "proton-mail-bridge-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "cli": "npm run build && node dist/cli.js",
    "install:claude-desktop": "npm run build && node dist/scripts/install-claude-desktop.js",
    "update:claude-desktop": "npm run install:claude-desktop",
    "setup:claude-desktop": "npm run build && node dist/scripts/setup-claude-desktop.js",
    "check:claude-desktop": "npm run build && node dist/scripts/check-claude-desktop.js",
    "doctor:claude-desktop": "npm run check:claude-desktop",
    "repair:claude-desktop": "npm run install:claude-desktop",
    "test:unit": "npm run build && node --test test/*.test.mjs",
    "test": "npm run build && node --input-type=module -e \"import('./dist/index.js')\" && node --test test/*.test.mjs",
    "smoke:bridge": "npm run build && node dist/scripts/bridge-smoke.js",
    "prepare": "npm run build",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "ci": "npm run lint && npm test",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm run lint && npm test && npm run pack:check",
    "package:mcpb": "node scripts/build-mcpb.mjs"
  },
  "keywords": [
    "protonmail",
    "mcp",
    "email",
    "automation",
    "typescript",
    "claude",
    "ai",
    "productivity",
    "bridge",
    "smtp",
    "imap",
    "analytics",
    "professional"
  ],
  "author": {
    "name": "googlarz",
    "url": "https://github.com/googlarz"
  },
  "license": "MIT",
  "homepage": "https://github.com/googlarz/proton-mail-bridge-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/googlarz/proton-mail-bridge-client.git"
  },
  "bugs": {
    "url": "https://github.com/googlarz/proton-mail-bridge-client/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "better-sqlite3": "^12.8.0",
    "imapflow": "^1.4.8",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "sanitize-html": "^2.17.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.19",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "glama.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "better-sqlite3@12.8.0": true
  },
  "overrides": {
    "html-to-text": "10.0.1"
  }
}
